{
  "name": "gcworld/utilities",
  "description": "GCWorld Industries standard Utilities pack",
  "authors": [
    {
      "name": "GameCharmer",
      "email": "admin@gamecharmer.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "ext-curl": "*",
    "ext-gd": "*",
    "ramsey/uuid": "^4.9"
  },
  "autoload": {
    "psr-4": {
      "GCWorld\\Utilities\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GCWorld\\Utilities\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "test": "phpunit",
    "check": [
      "@lint",
      "@phpstan",
      "@phpcs",
      "@test"
    ]
  },
  "license": "proprietary",
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13"
  }
}
