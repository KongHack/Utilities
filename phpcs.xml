<?xml version="1.0"?>
<ruleset name="Utilities">
    <description>Utilities coding standard.</description>

    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg name="warning-severity" value="0"/>

    <file>src</file>
    <file>tests</file>

    <rule ref="PSR12">
        <!-- Preserve the package's existing public snake_case method names. -->
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps"/>
    </rule>
</ruleset>
